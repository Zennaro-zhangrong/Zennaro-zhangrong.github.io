    <item>
      <title>单片机从【复位】到【main】的过程</title>
      <link>http://localhost:1313/post/%E5%8D%95%E7%89%87%E6%9C%BA%E5%A4%8D%E4%BD%8D%E5%88%B0main%E5%87%BD%E6%95%B0%E7%9A%84%E8%BF%87%E7%A8%8B/</link>
